[sub_resource type="GDScript" id="GDScript_vedix"]
script/source = "extends PlayerState


func enter(previous_state_path: String, data := {}) -> void:
	player.sprite.play(\"fire\")
	await player.sprite.animation_finished
	finished.emit(IDLE)
"

