config_version=5

[application]

config/name="Rot"
run/main_scene="uid://g3nlfb2frfll"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

buses/default_bus_layout="uid://dlpkvi46makdh"

[autoload]

